# Provider execution order (comma-separated: browserless, zenrows, byparr)
CRAWLER_PROVIDERS=browserless,zenrows,byparr

# Browserless configuration
BROWSERLESS_TOKEN=your_browserless_token_here
BROWSERLESS_HOST=production-sfo.browserless.io
BROWSERLESS_MODE=unblock
BROWSERLESS_PROXY=residential
BROWSERLESS_BLOCK_ASSETS=true
BROWSERLESS_BLOCK_ADS=false
BROWSERLESS_TIMEOUT_MS=120000
BROWSERLESS_PERSIST_SESSION=true
# Optional: try /stealth with saved cookies before /unblock (disabled by default since residential IPs rotate)
BROWSERLESS_SESSION_FAST_PATH=false

# ZenRows Scraping Browser fallback configuration
ZENROWS_API_KEY=your_zenrows_api_key_here
ZENROWS_SESSION_TTL=120
# Optional two-letter country code (e.g. us, de, gb)
# ZENROWS_PROXY_COUNTRY=us

# Byparr (Docker Camoufox) + Go bogdanfinn/tls-client ultimate fallback
BYPARR_URL=http://127.0.0.1:8191/v1
BYPARR_ENABLED=true
